<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robo_reason_real</name>
  <version>0.1.0</version>
  <description>RoboReason ROS2 real robot integration. LLM-based task planning with UR5 skill execution.</description>
  <maintainer email="matteo.nini@example.com">Matteo Nini</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>
  <depend>robo_reason_interfaces</depend>

  <!-- Real robot dependencies (required for ur5_skill_executor_node) -->
  <exec_depend>ur5cb_interface_node</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
