<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robo_reason_perception</name>
  <version>0.1.0</version>
  <description>SAM 2 and GroundingDINO segmentation as a ROS service, run in the GPU perception container (ROBOAI-60).</description>
  <maintainer email="m.nini@unimore.it">matteo nini</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>robo_reason_interfaces</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
